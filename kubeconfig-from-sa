#!/bin/bash
# Build a kubeconfig from the in-cluster ServiceAccount token.
#
# kubectl, unlike a controller, does not pick up the in-cluster config by itself:
# without a kubeconfig it talks to localhost:8080 and fails. istioctl, helm, stern
# and kubectl-ko all read the same kubeconfig, so this fixes them in one go.
set -euo pipefail

SA=/var/run/secrets/kubernetes.io/serviceaccount

if [ ! -r "$SA/token" ]; then
  echo "kubeconfig-from-sa: no ServiceAccount token at $SA" >&2
  echo "  the pod runs with automountServiceAccountToken: false, or this is not a pod" >&2
  exit 1
fi

KCFG="${KUBECONFIG:-$HOME/.kube/config}"
mkdir -p "$(dirname "$KCFG")"

HOST="${KUBERNETES_SERVICE_HOST:-kubernetes.default.svc}"
PORT="${KUBERNETES_SERVICE_PORT:-443}"
case "$HOST" in *:*) HOST="[$HOST]" ;; esac   # IPv6
SERVER="https://${HOST}:${PORT}"
NS="$(cat "$SA/namespace" 2>/dev/null || echo default)"

kubectl config --kubeconfig="$KCFG" set-cluster in-cluster \
  --server="$SERVER" --certificate-authority="$SA/ca.crt" --embed-certs=true >/dev/null
kubectl config --kubeconfig="$KCFG" set-credentials sa \
  --token="$(cat "$SA/token")" >/dev/null
kubectl config --kubeconfig="$KCFG" set-context in-cluster \
  --cluster=in-cluster --user=sa --namespace="$NS" >/dev/null
kubectl config --kubeconfig="$KCFG" use-context in-cluster >/dev/null

echo "kubeconfig: $KCFG"
echo "server:     $SERVER"
echo "namespace:  $NS"
echo
echo "The token carries the permissions of this pod's ServiceAccount."
echo "If commands come back Forbidden, bind a role to it - see debug-rbac.yaml."
